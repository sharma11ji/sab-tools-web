rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Sirf admin. Email badalni ho to src/lib/admin.js mein bhi badlo.
    function isAdmin() {
      return request.auth != null
          && request.auth.token.email == "amrjeetgaming2@gmail.com"
          && request.auth.token.email_verified == true;
    }

    function signedIn() {
      return request.auth != null;
    }

    // Books: sab padh sakte hain, likh/badal/hata sirf admin sakta hai
    match /books/{bookId} {
      allow read: if true;
      allow write: if isAdmin();

      // Reviews: document ka id = review likhne wale ka uid, isliye ek user ka ek hi review.
      match /reviews/{uid} {
        allow read: if true;

        allow create, update: if signedIn()
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(["uid", "name", "photoURL", "rating", "text", "createdAt"])
          && request.resource.data.uid == uid
          && request.resource.data.rating is int
          && request.resource.data.rating >= 1
          && request.resource.data.rating <= 5
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 500
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 60
          && request.resource.data.photoURL is string
          && request.resource.data.createdAt == request.time;

        // Apna review khud hata sakte ho; admin kisi ka bhi hata sakta hai
        allow delete: if isAdmin() || (signedIn() && request.auth.uid == uid);
      }
    }

    // Book requests: logged-in user apni request bana sakta hai.
    // Padhna, badalna aur hatana sirf admin.
    match /apiRequests/{id} {
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }
  }
}
