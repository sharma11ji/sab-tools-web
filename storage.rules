rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Book ki files: sab padh sakte hain (READ NOW button kholne ke liye),
    // upload/badalna sirf admin, 50 MB tak. Email badalni ho to src/lib/admin.js mein bhi badlo.
    match /books-files/{file} {
      allow read: if true;

      allow create, update: if request.auth != null
        && request.auth.token.email == "amrjeetgaming2@gmail.com"
        && request.auth.token.email_verified == true
        && request.resource.size < 50 * 1024 * 1024;

      allow delete: if request.auth != null
        && request.auth.token.email == "amrjeetgaming2@gmail.com"
        && request.auth.token.email_verified == true;
    }
  }
}
